# =========================================================
# QNITY CSL Laboratory Renovation 2026 — Project Dashboard Portal
# PRODUCTION — Neon PostgreSQL, live project data
# =========================================================
#
# This is the configuration that carries the project of record: create,
# edit and delete persist, and the audit trail is written to the database.
#
# Add each variable in
#   Vercel → Project → Settings → Environment Variables
# for BOTH Production and Preview, then redeploy. An environment change
# alone does not rebuild the site.
#
# This file is a template. Do not commit real values — `.env*.local` and
# `.env` are git-ignored, this example is not.
#
# Full walkthrough: docs/VERCEL-POSTGRES.md
# Mock-only UAT instead: .env.vercel.example


# ---------------------------------------------------------
# 1. DATA SOURCE — the switch that makes everything else matter
# ---------------------------------------------------------
# Without this the portal serves its built-in dataset and ignores the
# database entirely: pages render, edits appear to work, and nothing is
# ever written. Verify with `npm run db:check`.
DATA_SOURCE=prisma


# ---------------------------------------------------------
# 2. NEON POSTGRESQL — two connection strings, not one
# ---------------------------------------------------------
# Neon Console → your project → Connect. Copy BOTH strings.
#
# DATABASE_URL is what the running app uses. It must be the POOLED string
# — the host contains "-pooler". Every serverless invocation opens its own
# connection, and without the pooler a busy dashboard exhausts the
# connection limit and requests start failing with "too many clients".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx-pooler.ap-southeast-1.aws.neon.tech/qnity_csl?sslmode=require"

# DIRECT_URL is what MIGRATIONS use — the same host WITHOUT "-pooler".
# Prisma's migration engine needs advisory locks and DDL that a transaction
# pooler cannot carry, so a migration through the pooled string hangs.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/qnity_csl?sslmode=require"

# Notes on the Neon strings:
#   - Keep `sslmode=require`. Neon refuses unencrypted connections.
#   - If the console gives you `channel_binding=require`, keep that too.
#   - Choose the region nearest Thailand Science Park — ap-southeast-1
#     (Singapore) — to match the `sin1` function region in vercel.json.
#   - Neon auto-suspends an idle database. The first query after a pause
#     pays a resume cost of roughly a second; the app retries a connection
#     dropped that way rather than surfacing it as a failed save.
#
# One-time setup, run from your own machine with both variables exported:
#   npm run db:deploy     # create every table from prisma/migrations
#   npm run seed          # load the QNITY 2026 baseline
#   npm run db:check      # confirm all of the above


# ---------------------------------------------------------
# 3. AUTHENTICATION — required
# ---------------------------------------------------------
# Session signing key. Generate a fresh one, never reuse an example:
#   openssl rand -base64 32
# Without it every sign-in lands on /login?error=Configuration.
AUTH_SECRET=

# Public origin of the deployment. Required once Entra ID is enabled,
# because the OAuth redirect URI must match a fixed domain.
AUTH_URL="https://csl-portal.qnity.com"


# ---------------------------------------------------------
# 4. MICROSOFT ENTRA ID — how people actually sign in
# ---------------------------------------------------------
# With DATA_SOURCE=prisma the shared demo password is closed by default
# (see section 5), so this is the way in. Azure Portal → App registrations.
#
# Redirect URI to register:  {AUTH_URL}/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"

# An Entra account with no active portal record is refused at sign-in — the
# directory proves who someone is, the User table decides what they may see.
# Provision people from the Admin Panel, or let them request access.


# ---------------------------------------------------------
# 5. DEMO SIGN-IN — off by default in production
# ---------------------------------------------------------
# LEAVE THIS UNSET. With DATA_SOURCE=prisma the demo provider is disabled
# automatically, because a door opened by one password published in this
# repository has no business in front of real project records. The login
# page explains the situation rather than just showing nothing.
#
# Set it to "true" ONLY to test the migration before Entra ID is wired up,
# and remove it immediately afterwards. If you do, also set a strong
# DEMO_PASSWORD (openssl rand -base64 18) — the built-in default is public.
# ENABLE_DEMO_LOGIN=true
# DEMO_PASSWORD=


# ---------------------------------------------------------
# 6. ACCESS CONTROL
# ---------------------------------------------------------
# Always resolved to ADMIN on sign-in, so the portal owner cannot be locked
# out of their own deployment.
PRIMARY_ADMIN_EMAIL="warisa.kantifong@qnity.com"

# Domains treated as internal. Anyone outside them is flagged as an
# external user when invited from the Admin Panel.
INTERNAL_EMAIL_DOMAINS="qnity.com"


# ---------------------------------------------------------
# 7. FILE UPLOADS
# ---------------------------------------------------------
# Vercel's filesystem is read-only, so "local" cannot persist uploads
# there. Leave it until SharePoint storage is configured — the upload
# controls render disabled rather than failing at the moment of use.
FILE_STORAGE_DRIVER=local
MAX_UPLOAD_SIZE_MB=25
