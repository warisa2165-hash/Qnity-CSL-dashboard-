# =========================================================
# QNITY CSL Laboratory Renovation 2026 - Project Dashboard Portal
# Copy this file to `.env.local` (development) or configure the
# same variables in your hosting platform (production).
# =========================================================

# ---------------------------------------------------------
# DATA SOURCE
# ---------------------------------------------------------
# "mock"   -> the portal serves the built-in QNITY mock dataset.
#             No database is required. Good for local work and UAT.
# "prisma" -> the portal reads AND WRITES PostgreSQL through Prisma.
#             This is production. See .env.production.example for a
#             Neon-shaped template, and docs/VERCEL-POSTGRES.md.
DATA_SOURCE=mock

# ---------------------------------------------------------
# DATABASE (only required when DATA_SOURCE=prisma)
# ---------------------------------------------------------
# The connection the running app uses. On a serverless host this must be
# the POOLED string, or concurrent invocations exhaust max_connections.
DATABASE_URL="postgresql://qnity:qnity@localhost:5432/qnity_csl?schema=public"

# The connection MIGRATIONS use. A transaction pooler (PgBouncer) cannot run
# the advisory locks and DDL that `prisma migrate` needs, so it must be the
# DIRECT string. With a plain PostgreSQL server and no pooler, set this to
# the same value as DATABASE_URL.
DIRECT_URL="postgresql://qnity:qnity@localhost:5432/qnity_csl?schema=public"

# Create the schema and load the baseline (once, from a machine you control):
#   npm run db:deploy && npm run seed
# See docs/VERCEL-POSTGRES.md for the Vercel walkthrough.

# ---------------------------------------------------------
# AUTHENTICATION (Auth.js / NextAuth v5)
# ---------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Public base URL of the deployment, e.g. https://csl-portal.qnity.com
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# ---------------------------------------------------------
# MICROSOFT ENTRA ID (Azure AD) - preferred sign-in method
# ---------------------------------------------------------
# App registration -> Overview
AUTH_MICROSOFT_ENTRA_ID_ID=""
# App registration -> Certificates & secrets -> Client secret VALUE
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Directory (tenant) ID, or "common" for multi-tenant
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"

# Redirect URI to register in Entra ID:
#   {AUTH_URL}/api/auth/callback/microsoft-entra-id

# ---------------------------------------------------------
# DEMO SIGN-IN
# ---------------------------------------------------------
# Enables the credential-based role switcher on the login page so the
# portal can be evaluated without an Entra ID tenant.
# When UNSET the default follows DATA_SOURCE: enabled on mock, disabled on
# prisma — a deployment carrying live records does not get a shared-password
# door by accident. Set it explicitly only to override that.
ENABLE_DEMO_LOGIN=true
# Shared password for every demo account (demo login only).
DEMO_PASSWORD="qnity2026"

# ---------------------------------------------------------
# ACCESS CONTROL
# ---------------------------------------------------------
# Email of the primary system administrator. This account is always
# provisioned with the ADMIN role on first sign-in.
PRIMARY_ADMIN_EMAIL="warisa.kantifong@qnity.com"
# Comma separated list of e-mail domains allowed to self-register.
# Anyone outside these domains lands in the access-request queue.
INTERNAL_EMAIL_DOMAINS="qnity.com"

# ---------------------------------------------------------
# FILE UPLOADS
# ---------------------------------------------------------
# "local" (public/uploads) or "sharepoint" (see docs/DATA-INTEGRATION.md)
FILE_STORAGE_DRIVER=local
MAX_UPLOAD_SIZE_MB=25
