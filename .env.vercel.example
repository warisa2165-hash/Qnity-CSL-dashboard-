# =========================================================
# QNITY CSL Laboratory Renovation 2026 — Project Dashboard Portal
# Vercel UAT deployment — MOCK DATA ONLY
# =========================================================
#
# These are the only variables the UAT deployment needs. Add each one in
#   Vercel → Project → Settings → Environment Variables
# and tick BOTH "Production" and "Preview" so preview builds behave the
# same as the UAT site.
#
# This file is a template. Do not commit real values.
#
# For the full production picture (database, Microsoft Entra ID, file
# storage) see `.env.example` and docs/DEPLOYMENT.md instead.

# ---------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------

# Serve the built-in QNITY 2026 dataset. No database is used or needed.
DATA_SOURCE=mock

# Session signing key. Generate a fresh one — never reuse an example value:
#   openssl rand -base64 32
# Changing it later signs everyone out, which is harmless during UAT.
AUTH_SECRET=

# Lets Auth.js trust the forwarded host header, which is how it resolves
# callback URLs behind Vercel's proxy.
AUTH_TRUST_HOST=true

# ---------------------------------------------------------
# DEMO SIGN-IN — enabled for UAT
# ---------------------------------------------------------
# The login page shows a role switcher so testers can move between the
# administrator, leadership, project team, consultant and contractor views.
ENABLE_DEMO_LOGIN=true

# Shared password for EVERY demo account. The UAT site is reachable by
# anyone who has the link, so replace the built-in default with a strong
# passphrase and share it only with the UAT group.
#   openssl rand -base64 18
DEMO_PASSWORD=

# ---------------------------------------------------------
# ACCESS CONTROL
# ---------------------------------------------------------
# Always resolved to the administrator role on sign-in, so the portal owner
# cannot be locked out.
PRIMARY_ADMIN_EMAIL=warisa.kantifong@qnity.com

# Domains treated as internal. Anyone outside them is flagged as an
# external user when invited from the Admin Panel.
INTERNAL_EMAIL_DOMAINS=qnity.com

# ---------------------------------------------------------
# DELIBERATELY NOT SET
# ---------------------------------------------------------
# DATABASE_URL
#   Not required. `prisma generate` runs during the build but never
#   connects, and DATA_SOURCE=mock means no query is ever issued.
#
# AUTH_MICROSOFT_ENTRA_ID_ID / _SECRET / _ISSUER
#   Leaving these unset keeps Entra ID sign-in switched off. The login page
#   says so plainly and offers demo access only. Add them when you are ready
#   to move from UAT to a real tenant.
#
# AUTH_URL
#   Leave unset. Auth.js derives the origin from the request, so the same
#   configuration works on the production domain and on every preview
#   deployment. Set it explicitly only once Entra ID is enabled, because the
#   OAuth redirect URI must then match a fixed domain.
#
# FILE_STORAGE_DRIVER
#   Vercel's filesystem is read-only, so local uploads cannot work there.
#   Upload controls are disabled in the mock build, so nothing depends on it.
